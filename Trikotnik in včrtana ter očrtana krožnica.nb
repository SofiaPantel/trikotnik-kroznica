 CellChangeTimes->{{3.990027551856304*^9, 3.990027570481388*^9}, 
   3.9900276647296524`*^9},ExpressionUUID->"1678dd7e-624e-c941-b5d8-\
afe2d474fc54"],

Cell["\<\
V\[CHacek]rtana kro\[ZHacek]nica je kro\[ZHacek]nica, ki se dotika vseh treh \
stranic trikotnika.
Njeno sredi\[SHacek]\[CHacek]e le\[ZHacek]i v prese\[CHacek]i\[SHacek]\
\[CHacek]u simetral notranjih kotov trikotnika, polmer pa je enak razdalji od \
sredi\[SHacek]\[CHacek]a do poljubne stranice.\
\>", "Text",
 CellChangeTimes->{{3.9900263209971523`*^9, 
  3.9900263256378307`*^9}},ExpressionUUID->"683b3024-8ddb-4546-a933-\
67d614c008a6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "SredisceVcrtane", "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SredisceVcrtane", "[", "t_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ogli\[SHacek]\[CHacek]a", ",", "A", ",", "B", ",", "C", ",", "a", ",", 
      "b", ",", "c"}], "}"}], ",", 
    RowBox[{
     RowBox[{"ogli\[SHacek]\[CHacek]a", "=", 
      RowBox[{"Oglisca", "[", "t", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"A", ",", "B", ",", "C"}], "}"}], "=", 
      RowBox[{"Koordinate", "/@", "ogli\[SHacek]\[CHacek]a"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", 
      RowBox[{
       RowBox[{"DolzineStranic", "[", "t", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3", ",", "1"}], "}"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"a", " ", "A"}], "+", 
        RowBox[{"b", " ", "B"}], "+", 
        RowBox[{"c", " ", "C"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"a", "+", "b", "+", "c"}], ")"}]}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.990026354152487*^9, 3.990026354152487*^9}},
