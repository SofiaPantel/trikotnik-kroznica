   3.9900197165446453`*^9},ExpressionUUID->"59d91052-9c3f-5444-8dc4-\
56244105d931"],

Cell["\<\
Tip trikotnika dolo\[CHacek]imo na podlagi dol\[ZHacek]in njegovih stranic. \
Trikotnik je lahko enakostrani\[CHacek]ni, enakokraki ali \
raznostrani\[CHacek]ni.\
\>", "Text",
 CellChangeTimes->{
  3.99002612224922*^9},ExpressionUUID->"bf8d0aa6-52e2-bb4e-a0a0-e3cddecc11a7"],

