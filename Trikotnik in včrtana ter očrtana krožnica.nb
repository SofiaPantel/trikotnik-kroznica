  3.9900276820287495`*^9}},ExpressionUUID->"d5f4c8a2-2358-e944-832e-\
f10bc43b56c5"],

Cell["\<\
O\[CHacek]rtana kro\[ZHacek]nica je kro\[ZHacek]nica, ki poteka skozi vsa tri \
ogli\[SHacek]\[CHacek]a trikotnika. Njeno sredi\[SHacek]\[CHacek]e je prese\
\[CHacek]i\[SHacek]\[CHacek]e simetral stranic trikotnika.\
\>", "Text",
 CellChangeTimes->{
  3.9900276922470684`*^9},ExpressionUUID->"6d6492b6-7f1f-334f-ab51-\
009ce429970c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "SredisceOcrtane", "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SredisceOcrtane", "[", "t_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"toc", ",", "x", ",", "y", ",", "s"}], "}"}], ",", 
    RowBox[{
     RowBox[{"toc", "=", 
      RowBox[{"Koordinate", "/@", 
       RowBox[{"Oglisca", "[", "t", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], "/.", " ", 
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"EuclideanDistance", "[", 
