  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "stranice", "}"}], ",", 
    RowBox[{
     RowBox[{"stranice", "=", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"DolzineStranic", "[", "t", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "stranice", "]"}], "==", "1"}], 
       ",", "\"\<Enakostrani\[CHacek]ni\>\"", ",", 
       RowBox[{
        RowBox[{"Length", "[", "stranice", "]"}], "==", "2"}], 
       ",", "\"\<Enakokraki\>\"", ",", "True", 
       ",", "\"\<Raznostrani\[CHacek]ni\>\""}], "]"}]}]}], "]"}]}]}], "Input",
