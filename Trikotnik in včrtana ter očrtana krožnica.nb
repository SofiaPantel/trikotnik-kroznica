3beac0f37fe8"],

Cell["\<\
Obseg trikotnika je vsota dol\[ZHacek]in vseh njegovih stranic. Plo\[SHacek]\
\[CHacek]ino trikotnika izra\[CHacek]unamo s Heronovo formulo, kjer najprej \
dolo\[CHacek]imo polovi\[CHacek]ni obseg.\
\>", "Text",
 CellChangeTimes->{
  3.9900258739090786`*^9},ExpressionUUID->"ae7ac3c1-d4a3-a641-84d4-\
46219cdc5ed4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"Obseg", ",", "Ploscina"}], "]"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Obseg", "[", "t_", "]"}], ":=", 
   RowBox[{"Apply", "[", 
    RowBox[{"Plus", ",", 
     RowBox[{"DolzineStranic", "[", "t", "]"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Ploscina", "[", "t_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c", ",", "s"}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", 
      RowBox[{"DolzineStranic", "[", "t", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"s", "=", 
      RowBox[{
       RowBox[{"Obseg", "[", "t", "]"}], "/", "2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"s", " ", 
       RowBox[{"(", 
        RowBox[{"s", "-", "a"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"s", "-", "b"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"s", "-", "c"}], ")"}]}], "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{3.9900259015584908`*^9},
 CellLabel->"In[24]:=",ExpressionUUID->"346b660e-7157-d348-95f0-a40946062fc9"],

